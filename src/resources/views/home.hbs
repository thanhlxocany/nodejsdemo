<section class="hero shadow-sm rounded-4 p-4 p-md-5">
  <div class="row align-items-center g-4">
    <div class="col-lg-8">
      <span class="badge text-bg-primary mb-3">Bootstrap integrated</span>
      <h1 class="display-4 fw-bold mb-3">{{heading}}</h1>
      <p class="description lead text-secondary">{{description}}</p>
    </div>
    <div class="col-lg-4 text-center">
      <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 140px; height: 140px; font-size: 3rem;">
        <i class="bi bi-bootstrap"></i>
      </div>
    </div>
  </div>

  <div class="row g-3 mt-4">
    {{#each features}}
      <div class="col-md-4">
        <div class="feature h-100 border rounded-3 p-3 bg-white">{{this}}</div>
      </div>
    {{/each}}
  </div>
</section>
